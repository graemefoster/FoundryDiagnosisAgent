@token={{$dotenv FOUNDRY_TOKEN}}
@subscriptionid=<sub-id>
@agent=diagnostics-agent
@foundry=<foundry-name>
@project=<project-name>
@rg=<resource-group-name>
@model=gpt-5.4
@agentAcrImage=grfacragents.azurecr.io/foundry-diagnostics-agent:0.14

### Create the Agent in Foundry
POST https://{{foundry}}.services.ai.azure.com/api/projects/{{project}}/agents?api-version=2025-11-15-preview
Content-Type: application/json
Authorization: Bearer {{token}}
Foundry-Features: HostedAgents=V1Preview

{
  "name": "{{agent}}",
  "definition": {
    "kind": "hosted",
    "container_protocol_versions": [
      {
        "protocol": "invocations",
        "version": "1.0.0"
      }
    ],
    "cpu": "0.5",
    "memory": "1Gi",
    "image": "{{agentAcrImage}}",
    "environment_variables": {
      "AZURE_AI_MODEL_DEPLOYMENT_NAME": "{{model}}"
    }
  },
  "description": "A Foundry Network and Integration Diagnostics Agent"
}

### Update the Agent in Foundry
POST https://{{foundry}}.services.ai.azure.com/api/projects/{{project}}/agents/{{agent}}?api-version=2025-11-15-preview
Content-Type: application/json
Authorization: Bearer {{token}}
Foundry-Features: HostedAgents=V1Preview

{
  "name": "{{agent}}",
  "definition": {
    "kind": "hosted",
    "container_protocol_versions": [
      {
        "protocol": "invocations",
        "version": "1.0.0"
      }
    ],
    "cpu": "0.5",
    "memory": "1Gi",
    "image": "{{agentAcrImage}}",
    "environment_variables": {
      "AZURE_AI_MODEL_DEPLOYMENT_NAME": "{{model}}"
    }
  },
  "description": "A Foundry Network and Integration Diagnostics Agent"
}

